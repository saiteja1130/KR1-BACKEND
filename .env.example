# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kr1_database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.example.mongodb.net/kr1_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=kr1_secure_jwt_secret_key_2026_super_secret_phrase
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by seed script)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@kr1.in
ADMIN_PASSWORD=Admin@kr1_2026!
ADMIN_PHONE=+919666193543

# Payment Configuration
PAYMENT_AMOUNT=1500

# UPI Payment (QR Code + Manual UTR Verification)
# These are displayed on the payment page QR code and copy button
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=KR Material and Manpower

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="KR Material & Manpower" <info@kr1.in>
